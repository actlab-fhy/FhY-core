class Expression:
    @property
    def is_frozen(self) -> bool: ...
    @override
    def __eq__(self, other: object) -> bool: ...
    @override
    def __ne__(self, other: object) -> bool: ...
    @override
    def __hash__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def _format(self, show_id: bool = False, functional: bool = False) -> str: ...
    @classmethod
    def get_visit_method_suffix(cls) -> str: ...
    def accept(self, visitor: Any) -> Any: ...
    def get_visit_children(self) -> tuple[_Expression, ...]: ...
    def rebuild_with_visit_children(
        self, new_children: Sequence[_Expression]
    ) -> _Expression: ...
    def get_free_identifiers(self) -> frozenset[Identifier]: ...
    def substitute(self, replacements: Mapping[Identifier, Term]) -> _Expression: ...
    def is_structurally_equivalent(self, other: object) -> bool: ...
    def is_alpha_equivalent(self, other: object) -> bool: ...
    def is_alpha_equivalent_under(
        self, other: object, renaming: AlphaRenaming
    ) -> bool: ...
    @staticmethod
    def _get_expression_from_other(other: object) -> _Expression: ...
    def __neg__(self) -> _UnaryExpression: ...
    def __pos__(self) -> _UnaryExpression: ...
    def __add__(self, other: object) -> _BinaryExpression: ...
    def __radd__(self, other: object) -> _BinaryExpression: ...
    def __sub__(self, other: object) -> _BinaryExpression: ...
    def __rsub__(self, other: object) -> _BinaryExpression: ...
    def __mul__(self, other: object) -> _BinaryExpression: ...
    def __rmul__(self, other: object) -> _BinaryExpression: ...
    def __truediv__(self, other: object) -> _BinaryExpression: ...
    def __rtruediv__(self, other: object) -> _BinaryExpression: ...
    def __floordiv__(self, other: object) -> _BinaryExpression: ...
    def __rfloordiv__(self, other: object) -> _BinaryExpression: ...
    def __mod__(self, other: object) -> _BinaryExpression: ...
    def __rmod__(self, other: object) -> _BinaryExpression: ...
    def __pow__(self, other: object, modulo: None = None) -> _BinaryExpression: ...
    def __rpow__(self, other: object, modulo: None = None) -> _BinaryExpression: ...
    def __lt__(self, other: object) -> _BinaryExpression: ...
    def __le__(self, other: object) -> _BinaryExpression: ...
    def __gt__(self, other: object) -> _BinaryExpression: ...
    def __ge__(self, other: object) -> _BinaryExpression: ...
    def equals(self, other: object) -> _BinaryExpression: ...
    def not_equals(self, other: object) -> _BinaryExpression: ...
    def logical_and(self, *others: object) -> _LogicalExpression: ...
    def logical_or(self, *others: object) -> _LogicalExpression: ...
    def freeze(self) -> None: ...
    def assert_frozen(self) -> None: ...
    @classmethod
    def _register_public_class(cls) -> None: ...

